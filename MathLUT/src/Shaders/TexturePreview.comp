#version 430 core

layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) buffer OutputBuffer
{
    vec4 values[];
};

uniform int textureWidth;
uniform int textureHeight;

//MATHLUT_UNIFORMS

void main()
{
    uint xIndex = gl_GlobalInvocationID.x;
    uint yIndex = gl_GlobalInvocationID.y;

    if (xIndex >= uint(textureWidth) || yIndex >= uint(textureHeight))
        return;

    float x = textureWidth > 1 ? float(xIndex) / float(textureWidth - 1) : 0.0;
    float y = textureHeight > 1 ? float(yIndex) / float(textureHeight - 1) : 0.0;

    uint index = yIndex * uint(textureWidth) + xIndex;
    vec4 result = vec4(0.0, 0.0, 0.0, 1.0);

    //MATHLUT_FUNCTION

    values[index] = result;
}
